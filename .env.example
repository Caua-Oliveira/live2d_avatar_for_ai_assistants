# O Gemini Live só conecta quando o usuário inicia uma conversa ao vivo.
GEMINI_API_KEY=
# Alternativamente, informe um arquivo seguro fora do repositório contendo a chave.
GEMINI_API_KEY_FILE=
GEMINI_LIVE_ENABLED=true
GEMINI_LIVE_MODEL=gemini-3.8-live
# Exemplos de vozes pré-definidas: Aoede, Kore, Leda.
GEMINI_LIVE_VOICE=Aoede
# Fixa idioma/sotaque e reduz temperatura para manter o timbre vocal mais estável.
# Deixe em branco para omitir o parâmetro na requisição ao provedor.
GEMINI_LIVE_LANGUAGE_CODE=pt-BR
GEMINI_LIVE_TEMPERATURE=0.4
GEMINI_LIVE_AFFECTIVE_DIALOG=false
GEMINI_LIVE_MAX_SECONDS=900
GEMINI_LIVE_CONNECT_TIMEOUT_SECONDS=20
# Espera máxima por reparo de animação em um turno Live (também aceita LLM_TIMEOUT_SECONDS).
GEMINI_LIVE_REPAIR_TIMEOUT_SECONDS=60
# Origens do frontend separadas por vírgula para CORS e WebSocket; vazio libera dev local / mesma origem.
GEMINI_LIVE_ALLOWED_ORIGINS=
